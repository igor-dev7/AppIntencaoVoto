<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A entrevista guarda a posição geográfica junto com os dados -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppIntencaoVoto">

        <!-- Pesquisa estimulada: primeira das três telas -->
        <activity
            android:name=".EstimuladaActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ProblemasActivity"
            android:exported="false"
            android:parentActivityName=".EstimuladaActivity" />

        <activity
            android:name=".DadosActivity"
            android:exported="false"
            android:parentActivityName=".ProblemasActivity"
            android:windowSoftInputMode="adjustResize" />
        <!-- Ranking com os votos acumulados, última tela do fluxo -->
        <activity
            android:name=".RankingActivity"
            android:exported="false"
            android:parentActivityName=".EstimuladaActivity" />
    </application>

</manifest>
