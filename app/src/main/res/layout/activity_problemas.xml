<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProblemasActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/btConfirmar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="40dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/Texto.Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="22dp"
                android:text="@string/problemas_titulo" />

            <CheckBox
                android:id="@+id/cbSaude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_opcao_normal"
                android:minHeight="58dp"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:drawableStart="@drawable/ic_saude"
                android:drawablePadding="14dp"
                android:text="@string/problema_saude"
                android:textColor="@color/tinta"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbEducacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_opcao_normal"
                android:minHeight="58dp"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:drawableStart="@drawable/ic_educacao"
                android:drawablePadding="14dp"
                android:text="@string/problema_educacao"
                android:textColor="@color/tinta"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbTransporte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_opcao_normal"
                android:minHeight="58dp"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:drawableStart="@drawable/ic_transporte"
                android:drawablePadding="14dp"
                android:text="@string/problema_transporte"
                android:textColor="@color/tinta"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbViolencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_opcao_normal"
                android:minHeight="58dp"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:drawableStart="@drawable/ic_violencia"
                android:drawablePadding="14dp"
                android:text="@string/problema_violencia"
                android:textColor="@color/tinta"
                android:textSize="16sp"
                android:textStyle="bold" />


            <!-- Problema que não está na lista: o entrevistador digita -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_opcao_normal"
                android:gravity="center_vertical"
                android:minHeight="58dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <CheckBox
                    android:id="@+id/cbOutro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/problema_outro" />

                <EditText
                    android:id="@+id/etOutro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:enabled="false"
                    android:hint="@string/problema_outro"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="text|textCapSentences"
                    android:textColor="@color/tinta"
                    android:textColorHint="@color/texto_fraco"
                    android:textSize="16sp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btConfirmar"
        style="@style/Botao.Principal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:text="@string/confirmar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
